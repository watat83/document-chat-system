{
  "name": "document-chat-system",
  "version": "1.0.0",
  "description": "Open-source document management system with AI-powered chat interface",
  "private": false,
  "keywords": [
    "document-management",
    "chat",
    "ai",
    "nextjs",
    "typescript",
    "react",
    "open-source"
  ],
  "author": "Document Chat System Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/document-chat-system.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:inngest\" \"npm run dev:docling\" --names \"NEXT,INNGEST,DOCLING\" --prefix-colors \"cyan,magenta,yellow\"",
    "dev:next": "next dev --webpack",
    "dev:inngest": "./scripts/start-inngest.sh",
    "dev:docling": "./services/docling-api/start.sh",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:setup": "npm install && npm run db:generate && npm run db:push",
    "dev:reset": "npm run db:reset && npm run db:seed && npm run dev",
    "test:regression": "node --import tsx --test tests/regression/*.test.ts",
    "check:production-env": "node scripts/validate-production-env.mjs",
    "type-check:all": "tsc --noEmit",
    "test:migrations": "node scripts/test-migrations.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
